# Copy this file to `.env` (NOT .env.local) — `vercel dev` loads `.env` for
# this zero-config project. Both .env and .env.local are gitignored.
#
# ---- Workato (check-in gateway) -------------------------------------------
# BASE URL of your Workato API collection (e.g. .../attendence-tracking-system-v1,
# with no trailing endpoint). The app appends sub-paths:
#   POST {base}/check-in  — records one check-in (key + session_date + email)
#   GET  {base}/sessions  — lists sessions for the trainer dropdown
# Leave both unset locally to use the built-in mock backend (api/submit.js
# returns success and the dropdown shows demo sessions, without calling Workato).
WORKATO_API_URL=https://your-endpoint.workato.com/attendence-tracking-system-v1
WORKATO_API_KEY=your-api-key

# ---- Trainer gate (/team) -------------------------------------------------
# Password trainers type on /team to unlock the QR generator. Checked
# server-side in api/trainer-login.js; never sent to the browser.
TRAINER_PASSWORD=choose-a-trainer-password

# ---- Link signing ---------------------------------------------------------
# Secret used to sign check-in links so only trainer-generated QR codes work
# (a guessed/edited URL has no valid signature and is rejected at check-in).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, signing is disabled and any link is accepted (demo mode).
SIGNING_SECRET=generate-a-long-random-hex-string

# ---- Survey report (/api/survey-report) -----------------------------------
# Shared key the Workato survey recipe sends in the X-Report-Key header when it
# asks for the branded PDF report. Checked server-side with a constant-time
# compare in api/survey-report.py.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the endpoint is open (demo mode). Always set it on Vercel.
REPORT_API_KEY=generate-a-long-random-hex-string
